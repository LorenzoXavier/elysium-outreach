# Copy to .env and fill in for local SMTP delivery (development).
# Preferred: Gmail (GMAIL_USERNAME/GMAIL_PASSWORD -- use a Gmail App Password, not
# your real password: https://myaccount.google.com/apppasswords).
GMAIL_USERNAME=
GMAIL_PASSWORD=

# Fallback if GMAIL_USERNAME isn't set: any generic SMTP provider.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=example.com

# Optional: overrides the "from" address used by ApplicationMailer.
OUTREACH_MAILER_FROM=lorenzo@elysium.uk

# Regardless of which credentials are set above, in development real delivery only
# happens when the "Dev mail" banner toggle is switched ON (defaults to OFF, routing
# everything to local Mailpit at localhost:1025 instead -- run `mailpit` or
# `docker run -p 1025:1025 -p 8025:8025 axllent/mailpit` and view caught mail at
# http://localhost:8025).

# Gemini API key for the Email Templates "AI Assistant" (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
