# Copy to .env and fill in for local SMTP delivery (development).
# If left unset in development, mail delivery falls back to :test (captured in memory, nothing sent).
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=example.com

# Optional: overrides the "from" address used by ApplicationMailer.
OUTREACH_MAILER_FROM=outreach@elysium.uk
