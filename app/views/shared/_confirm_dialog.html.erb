<dialog id="turbo-confirm" data-controller="confirm-dialog"
        class="fixed inset-0 m-auto w-full max-w-sm rounded-lg border border-slate-200 p-0 shadow-xl backdrop:bg-slate-900/40">
  <form method="dialog" class="p-5">
    <p data-confirm-dialog-target="message" class="text-sm text-slate-700 mb-5"></p>
    <div class="flex justify-end gap-3">
      <button value="cancel" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
        Cancel
      </button>
      <button value="confirm" class="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">
        Confirm
      </button>
    </div>
  </form>
</dialog>
