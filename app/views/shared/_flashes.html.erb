<% if notice %>
  <div class="mb-6 rounded-md bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="mb-6 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
    <%= alert %>
  </div>
<% end %>
