<% content_for :title, "Scheduled Emails" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Scheduled Emails</h1>
    <p class="text-sm text-slate-500 mt-1">Everything queued via the contact email composer, delivered by Solid Queue.</p>
  </div>
  <span class="text-sm text-slate-500"><%= pluralize(@scheduled_emails.size, "email") %></span>
</div>

<% if @scheduled_emails.any? %>
  <div class="space-y-3">
    <% @scheduled_emails.each do |scheduled_email| %>
      <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <%= link_to scheduled_email.contact.display_name, scheduled_email.contact, class: "font-semibold text-slate-900 hover:underline" %>
            <%
              status_classes = {
                "scheduled" => "text-amber-600",
                "sent" => "text-emerald-600",
                "failed" => "text-red-600",
                "cancelled" => "text-slate-400"
              }
            %>
            <span class="text-xs font-semibold <%= status_classes[scheduled_email.status] %>">
              <%= scheduled_email.status.capitalize %>
            </span>
          </div>
          <p class="text-sm text-slate-600 mt-0.5 truncate"><%= scheduled_email.subject %></p>
          <p class="text-xs text-slate-500 mt-1">
            <% if scheduled_email.sent_at %>
              Sent <%= scheduled_email.sent_at.to_fs(:long) %>
            <% else %>
              Scheduled for <%= scheduled_email.scheduled_at.to_fs(:long) %>
            <% end %>
            <% if scheduled_email.failed? && scheduled_email.error_message.present? %>
              &middot; <span class="text-red-600"><%= scheduled_email.error_message.truncate(100) %></span>
            <% end %>
          </p>
        </div>

        <% if scheduled_email.scheduled? %>
          <%= button_to "Cancel", cancel_scheduled_email_path(scheduled_email), method: :post,
                data: { turbo_confirm: "Cancel this scheduled email?" },
                class: "shrink-0 rounded-md border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-slate-300 p-10 text-center text-slate-500">
    Nothing scheduled yet. Open a contact and click "Schedule Email" to compose one.
  </div>
<% end %>
