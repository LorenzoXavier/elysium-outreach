<% content_for :title, "Needs Action" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">
      <%= @filters[:status] == "archived" ? "Archived Contacts" : "Needs Action" %>
    </h1>
    <p class="text-sm text-slate-500 mt-1">
      <%= @filters[:status] == "archived" ? "Low priority contacts." : "Unique high & medium priority leads in the active outreach pipeline." %>
    </p>
  </div>
  <span class="text-sm text-slate-500"><%= pluralize(@pagy.count, "contact") %></span>
</div>

<%= render "filter_bar", filters: @filters %>

<% if @contacts.any? %>
  <div data-controller="bulk-select">
    <%= form_with url: bulk_mark_linkedin_outreached_contacts_path, method: :post do %>
      <div class="mb-3 flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-2.5">
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input type="checkbox" data-bulk-select-target="selectAll" data-action="change->bulk-select#toggleAll"
                 class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-500">
          Select all on this page
        </label>

        <div class="relative" data-controller="dropdown">
          <button type="button" data-bulk-select-target="menuButton"
                  data-action="dropdown#toggle" disabled
                  class="rounded-md border border-slate-300 px-2.5 py-1 text-slate-500 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent">
            &hellip;
          </button>
          <div data-dropdown-target="menu" class="hidden absolute right-0 z-10 mt-1 w-56 rounded-md border border-slate-200 bg-white py-1 shadow-lg">
            <button type="submit" data-bulk-select-target="submitButton"
                    data-turbo-confirm="Mark the selected contacts as LinkedIn outreached? This records today's date and sets each one's email follow-up due in 1 week."
                    class="block w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50">
              Mark as LinkedIn Outreached
            </button>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <%= render partial: "contacts/row", collection: @contacts, as: :contact, locals: { selectable: true } %>
      </div>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy, page_url: ->(n) { root_path(request.query_parameters.merge(page: n)) } %>
<% else %>
  <div class="rounded-lg border border-dashed border-slate-300 p-10 text-center text-slate-500">
    Nothing matches these filters right now. <%= link_to "Upload a CSV", new_import_path, class: "text-blue-600 hover:underline" %> to add leads.
  </div>
<% end %>
