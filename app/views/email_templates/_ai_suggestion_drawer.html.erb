<div id="ai_suggestion_drawer" data-ai-assistant-target="drawer" class="mt-3">
  <% if result.nil? %>
    <p class="text-xs text-slate-400 italic">AI suggestions will appear here -- nothing is applied until you click a "Use this" button.</p>
  <% elsif !result.success? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      <%= result.error %>
    </div>
  <% else %>
    <div class="rounded-md border border-indigo-200 bg-indigo-50 p-3 space-y-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Suggestion (not applied yet)</p>

      <% if result.subject.present? %>
        <div>
          <p class="text-xs text-indigo-600 mb-1">Subject</p>
          <p class="text-sm text-slate-900 bg-white rounded border border-indigo-100 px-2 py-1"
             data-ai-assistant-target="suggestedSubject"><%= result.subject %></p>
          <button type="button" data-action="ai-assistant#applySubject"
                  class="mt-1 rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-indigo-500">
            Use this subject
          </button>
        </div>
      <% end %>

      <% if result.body.present? %>
        <div>
          <p class="text-xs text-indigo-600 mb-1">Body</p>
          <p class="text-sm text-slate-900 bg-white rounded border border-indigo-100 px-2 py-1 whitespace-pre-wrap"
             data-ai-assistant-target="suggestedBody"><%= result.body %></p>
          <button type="button" data-action="ai-assistant#applyBody"
                  class="mt-1 rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-indigo-500">
            Use this body
          </button>
        </div>
      <% end %>

      <% if result.subject.present? && result.body.present? %>
        <button type="button" data-action="ai-assistant#applyBoth"
                class="rounded-md border border-indigo-300 px-2.5 py-1 text-xs font-semibold text-indigo-700 hover:bg-indigo-100">
          Use both
        </button>
      <% end %>
    </div>
  <% end %>
</div>
