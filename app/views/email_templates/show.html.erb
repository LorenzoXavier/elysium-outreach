<% content_for :title, @email_template.name %>

<div class="max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-slate-900"><%= @email_template.name %></h1>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_email_template_path(@email_template),
            class: "rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
      <%= button_to "Delete", @email_template, method: :delete,
            data: { turbo_confirm: "Delete the \"#{@email_template.name}\" template? This can't be undone." },
            class: "rounded-md border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50" %>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Subject</p>
      <p class="text-sm text-slate-900"><%= @email_template.subject %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Body</p>
      <p class="text-sm text-slate-900 whitespace-pre-wrap"><%= @email_template.body %></p>
    </div>
  </div>

  <%= link_to "Back to templates", email_templates_path, class: "inline-block mt-4 text-sm text-slate-500 hover:underline" %>
</div>
