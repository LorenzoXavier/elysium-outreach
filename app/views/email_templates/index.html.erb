<% content_for :title, "Email Templates" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Email Templates</h1>
    <p class="text-sm text-slate-500 mt-1">Reusable subject/body pairs to pre-fill the email composer.</p>
  </div>
  <%= link_to "New Template", new_email_template_path,
        class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
</div>

<% if @email_templates.any? %>
  <div class="space-y-3">
    <% @email_templates.each do |template| %>
      <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <%= link_to template.name, template, class: "font-semibold text-slate-900 hover:underline" %>
          <p class="text-sm text-slate-500 mt-0.5 truncate"><%= template.subject %></p>
        </div>
        <div class="flex items-center gap-2 shrink-0 text-xs font-semibold">
          <%= link_to "Edit", edit_email_template_path(template),
                class: "rounded-md border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50" %>
          <%= button_to "Delete", template, method: :delete,
                data: { turbo_confirm: "Delete the \"#{template.name}\" template? This can't be undone." },
                class: "rounded-md border border-red-200 px-3 py-1.5 text-red-600 hover:bg-red-50" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-slate-300 p-10 text-center text-slate-500">
    No templates yet. <%= link_to "Create one", new_email_template_path, class: "text-blue-600 hover:underline" %>.
  </div>
<% end %>
