<div id="<%= dom_id(contact) %>" class="bg-white border rounded-lg p-4 flex items-start gap-4 <%= contact.followup_overdue? ? 'border-red-300 ring-1 ring-red-200' : 'border-slate-200' %>">
  <% if local_assigns[:selectable] %>
    <input type="checkbox" name="contact_ids[]" value="<%= contact.id %>"
           data-bulk-select-target="checkbox" data-contact-id="<%= contact.id %>"
           data-action="change->bulk-select#sync"
           class="mt-1.5 h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-500 shrink-0">
  <% end %>

  <div class="min-w-0 flex-1 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <% if contact.followup_overdue? %>
        <div class="mb-2 inline-flex items-center gap-1.5 rounded-md bg-red-600 px-2 py-1 text-xs font-bold text-white">
          Email follow-up overdue
        </div>
      <% end %>

      <div class="flex items-center gap-2">
        <%= link_to contact.display_name, contact, class: "font-semibold text-slate-900 hover:underline" %>
        <%= render "contacts/priority_badge", contact: contact %>
      </div>

      <p class="text-sm text-slate-600 mt-0.5">
        <%= [contact.title, contact.company].select(&:present?).join(" @ ") %>
      </p>

      <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <% if contact.email.present? %>
          <span><%= contact.email %></span>
        <% end %>
        <% if contact.linkedin_url.present? %>
          <%= link_to "LinkedIn", contact.linkedin_url, target: "_blank", rel: "noopener", class: "text-blue-600 hover:underline" %>
        <% end %>
      </div>

      <p class="mt-2 text-xs text-slate-500">
        <% if contact.linkedin_outreached_at.present? %>
          LinkedIn outreached <%= time_ago_in_words(contact.linkedin_outreached_at) %> ago
          <% if contact.followup_status_text.present? %>
            &middot; <%= contact.followup_status_text %>
          <% end %>
        <% else %>
          Not yet contacted on LinkedIn
        <% end %>
        &middot; Email: <span class="font-medium"><%= contact.email_status.capitalize %></span>
      </p>
    </div>

    <div class="flex flex-col items-end gap-2 shrink-0">
      <%= render "contacts/priority_toggle", contact: contact %>

      <% if contact.linkedin_outreached_at.blank? %>
        <%= link_to "Draft LinkedIn Message", new_linkedin_message_contact_path(contact),
              data: { turbo_frame: "modal" },
              class: "shrink-0 whitespace-nowrap rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700" %>
      <% end %>

      <%= link_to "Edit Email", edit_email_contact_path(contact),
            class: "rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>
</div>
