<%
  levels = [["green", "High", "text-emerald-600"], ["amber", "Medium", "text-amber-600"], ["red", "Low", "text-red-600"]]
%>
<div class="inline-flex items-center gap-2 text-xs">
  <span class="text-slate-400">Priority:</span>
  <% levels.each do |value, label, color| %>
    <%= link_to label, update_priority_contact_path(contact, priority_status: value),
          data: { turbo_method: :patch },
          class: contact.priority_status == value ? "font-semibold #{color}" : "text-slate-400 hover:text-slate-600" %>
  <% end %>
</div>
