<% content_for :title, "Email #{@contact.display_name}" %>

<div class="max-w-2xl" data-controller="email-sync">
  <div class="flex items-center justify-between mb-2">
    <h1 class="text-2xl font-bold text-slate-900">Email &mdash; <%= @contact.display_name %></h1>
    <%= render "contacts/priority_badge", contact: @contact %>
  </div>

  <% if @contact.followup_overdue? %>
    <div class="mb-4 inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-xs font-bold text-white">
      Follow-up overdue &mdash; LinkedIn outreach was over a week ago with no email sent.
    </div>
  <% end %>

  <p class="text-sm text-slate-500 mb-4">
    To: <span class="font-medium text-slate-700"><%= @contact.email.presence || "No email address on file" %></span>
    &middot; Status: <span class="font-medium text-slate-700"><%= @contact.email_status.capitalize %></span>
  </p>

  <%= form_with url: update_email_contact_path(@contact), method: :patch, class: "space-y-3" do |f| %>
    <div class="flex items-center justify-between">
      <label for="contact_email_body" class="block text-sm font-medium text-slate-700">Email body</label>

      <span title="(Coming Soon)">
        <button type="button" disabled
                class="rounded-md bg-slate-100 border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-400 cursor-not-allowed">
          Generate Email via AI
        </button>
      </span>
    </div>

    <%= f.text_area :email_body, id: "contact_email_body", rows: 12,
          data: { "email-sync-target": "source", action: "input->email-sync#sync" },
          class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm font-mono" %>

    <div class="flex items-center gap-3">
      <%= f.submit "Save Draft", class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer" %>
      <%= link_to "Back", @contact, class: "text-sm text-slate-500 hover:underline" %>
    </div>
  <% end %>

  <%= form_with url: publish_email_contact_path(@contact), method: :post, class: "mt-3" do %>
    <input type="hidden" name="contact[email_body]" data-email-sync-target="target" value="<%= @contact.email_body %>">
    <%= submit_tag "Publish / Send Email",
          class: "w-full rounded-md bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-500 cursor-pointer",
          data: { turbo_confirm: @contact.email.blank? ? nil : "Send this email to #{@contact.email}?" } %>
  <% end %>
</div>
