<% content_for :title, @contact.display_name %>

<div class="max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-slate-900"><%= @contact.display_name %></h1>
      <%= render "contacts/priority_badge", contact: @contact %>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit details", edit_contact_path(@contact), class: "rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
      <%= link_to "Edit email", edit_email_contact_path(@contact), class: "rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700" %>
    </div>
  </div>

  <% if @contact.followup_overdue? %>
    <div class="mb-4 inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-xs font-bold text-white">
      Email follow-up overdue -- LinkedIn outreach was over a week ago with no email sent.
    </div>
  <% end %>

  <div class="bg-white border border-slate-200 rounded-lg p-6">
    <%= render "duplicates/attributes", contact: @contact %>
  </div>

  <div class="mt-4 bg-white border border-slate-200 rounded-lg p-6 text-sm space-y-2">
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">LinkedIn outreached</dt><dd><%= @contact.linkedin_outreached_at&.to_fs(:long) || "Not yet" %></dd></div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Email follow-up due</dt><dd><%= @contact.email_followup_due_at&.to_fs(:long) || "—" %></dd></div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Email status</dt><dd><%= @contact.email_status.capitalize %></dd></div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Source</dt><dd><%= @contact.source.presence || "—" %></dd></div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Import batch</dt><dd class="font-mono text-xs text-slate-500"><%= @contact.import_batch_id.presence || "—" %></dd></div>
    <% if @contact.notes.present? %>
      <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Notes</dt><dd><%= @contact.notes %></dd></div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= render "contacts/priority_toggle", contact: @contact %>
  </div>
</div>
