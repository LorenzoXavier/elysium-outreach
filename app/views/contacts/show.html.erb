<% content_for :title, @contact.display_name %>

<div class="max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-slate-900"><%= @contact.display_name %></h1>
      <%= render "contacts/priority_badge", contact: @contact %>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= render "contacts/linkedin_message_trigger", contact: @contact %>
      <%= link_to "Edit details", edit_contact_path(@contact), class: "shrink-0 whitespace-nowrap rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
      <%= link_to "Edit email", edit_email_contact_path(@contact), class: "shrink-0 whitespace-nowrap rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
      <%= link_to "Schedule Email", new_scheduled_email_contact_path(@contact), class: "shrink-0 whitespace-nowrap rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700" %>
    </div>
  </div>

  <% if @contact.followup_overdue? %>
    <div class="mb-4 inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-xs font-bold text-white">
      Email follow-up overdue -- LinkedIn outreach was over a week ago with no email sent.
    </div>
  <% end %>

  <div class="bg-white border border-slate-200 rounded-lg p-6">
    <%= render "duplicates/attributes", contact: @contact %>
  </div>

  <div class="mt-4 bg-white border border-slate-200 rounded-lg p-6 text-sm space-y-2">
    <div id="linkedin_outreach_details_<%= @contact.id %>" class="space-y-2">
      <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">LinkedIn outreached</dt><dd><%= @contact.linkedin_outreached_at&.to_fs(:long) || "Not yet" %></dd></div>
      <% if @contact.followup_status_text.present? %>
        <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500"><%= @contact.sent? ? "Follow-up" : "Follow-up due" %></dt><dd><%= @contact.followup_status_text %></dd></div>
      <% end %>
    </div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Email status</dt><dd><%= @contact.email_status.capitalize %></dd></div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Source</dt><dd><%= @contact.source.presence || "—" %></dd></div>
    <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Import batch</dt><dd class="font-mono text-xs text-slate-500"><%= @contact.import_batch_id.presence || "—" %></dd></div>
    <% if @contact.notes.present? %>
      <div class="flex gap-2"><dt class="w-40 shrink-0 text-slate-500">Notes</dt><dd><%= @contact.notes %></dd></div>
    <% end %>
  </div>

  <%= render "contacts/linkedin_message_display", contact: @contact %>

  <div class="mt-6">
    <%= render "contacts/priority_toggle", contact: @contact %>
  </div>

  <% scheduled = @contact.scheduled_emails.order(scheduled_at: :desc) %>
  <% if scheduled.any? %>
    <div class="mt-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Scheduled Emails</p>
      <div class="space-y-2">
        <% scheduled.each do |scheduled_email| %>
          <div class="bg-white border border-slate-200 rounded-lg p-3 flex items-center justify-between gap-3 text-sm">
            <div class="min-w-0">
              <p class="font-medium text-slate-900 truncate"><%= scheduled_email.subject %></p>
              <p class="text-xs text-slate-500">
                <%= scheduled_email.status.capitalize %>
                &middot;
                <% if scheduled_email.sent_at %>
                  sent <%= scheduled_email.sent_at.to_fs(:long) %>
                <% else %>
                  scheduled for <%= scheduled_email.scheduled_at.to_fs(:long) %>
                <% end %>
              </p>
            </div>
            <% if scheduled_email.scheduled? %>
              <%= button_to "Cancel", cancel_scheduled_email_path(scheduled_email), method: :post,
                    data: { turbo_confirm: "Cancel this scheduled email?" },
                    class: "shrink-0 rounded-md border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-600 hover:bg-red-50" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
