<div id="linkedin_message_display_<%= contact.id %>">
  <% if contact.linkedin_message.present? %>
    <div class="mt-4 bg-white border border-slate-200 rounded-lg p-4" data-controller="clipboard">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">LinkedIn Message</p>
        <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
                class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
          Copy
        </button>
      </div>
      <p class="text-sm text-slate-900 whitespace-pre-wrap" data-clipboard-target="source"><%= contact.linkedin_message %></p>
    </div>
  <% end %>
</div>
