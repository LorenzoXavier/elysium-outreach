<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <% if local_assigns[:selectable] %>
          <th class="w-10 px-4 py-2"></th>
        <% end %>
        <th class="px-4 py-2 text-left font-medium text-slate-500">Contact</th>
        <th class="px-4 py-2 text-left font-medium text-slate-500">Priority</th>
        <th class="px-4 py-2 text-left font-medium text-slate-500">LinkedIn / Follow-up</th>
        <th class="px-4 py-2 text-left font-medium text-slate-500">Email</th>
        <th class="px-4 py-2 text-right font-medium text-slate-500">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% contacts.each do |contact| %>
        <tr id="<%= dom_id(contact) %>_table" class="align-top <%= 'bg-red-50' if contact.followup_overdue? %>">
          <% if local_assigns[:selectable] %>
            <td class="px-4 py-3">
              <input type="checkbox" name="contact_ids[]" value="<%= contact.id %>"
                     data-bulk-select-target="checkbox" data-contact-id="<%= contact.id %>"
                     data-action="change->bulk-select#sync"
                     class="mt-1 h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-500">
            </td>
          <% end %>

          <td class="px-4 py-3 min-w-[14rem]">
            <%= link_to contact.display_name, contact, class: "font-semibold text-slate-900 hover:underline" %>
            <p class="text-xs text-slate-500 mt-0.5"><%= [contact.title, contact.company].select(&:present?).join(" @ ") %></p>
            <% if contact.email.present? %>
              <p class="text-xs text-slate-500"><%= contact.email %></p>
            <% end %>
            <% if contact.linkedin_url.present? %>
              <%= link_to "LinkedIn", contact.linkedin_url, target: "_blank", rel: "noopener", class: "text-xs text-blue-600 hover:underline" %>
            <% end %>
          </td>

          <td class="px-4 py-3">
            <%= render "contacts/priority_toggle", contact: contact %>
          </td>

          <td class="px-4 py-3 text-xs text-slate-500 min-w-[11rem]">
            <% if contact.followup_overdue? %>
              <div class="mb-1 inline-flex items-center rounded bg-red-600 px-1.5 py-0.5 text-[11px] font-bold text-white">
                Overdue
              </div>
            <% end %>
            <% if contact.linkedin_outreached_at.present? %>
              <p>Outreached <%= time_ago_in_words(contact.linkedin_outreached_at) %> ago</p>
              <% if contact.followup_status_text.present? %>
                <p><%= contact.followup_status_text %></p>
              <% end %>
            <% else %>
              <p>Not yet contacted</p>
            <% end %>
          </td>

          <td class="px-4 py-3 text-xs font-medium text-slate-600">
            <%= contact.email_status.capitalize %>
          </td>

          <td class="px-4 py-3 text-right whitespace-nowrap">
            <div class="inline-flex flex-col items-end gap-1">
              <% if contact.linkedin_outreached_at.blank? %>
                <%= link_to "Draft LinkedIn Message", new_linkedin_message_contact_path(contact),
                      data: { turbo_frame: "modal" },
                      class: "whitespace-nowrap rounded-md bg-slate-900 px-2.5 py-1 text-xs font-semibold text-white hover:bg-slate-700" %>
              <% end %>
              <%= link_to "Schedule Email", new_scheduled_email_contact_path(contact),
                    class: "rounded-md border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
