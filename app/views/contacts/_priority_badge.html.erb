<%
  badge_classes = {
    "green" => "bg-emerald-100 text-emerald-800",
    "amber" => "bg-amber-100 text-amber-800",
    "red"   => "bg-red-100 text-red-800"
  }
%>
<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= badge_classes[contact.priority_status] %>">
  <%= contact.priority_status.capitalize %>
</span>
