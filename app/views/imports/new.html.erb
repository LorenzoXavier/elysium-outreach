<% content_for :title, "Upload CSV" %>

<div class="max-w-xl">
  <h1 class="text-2xl font-bold text-slate-900 mb-1">Upload CSV</h1>
  <p class="text-sm text-slate-500 mb-6">
    Upload one or more CRM exports (e.g. "Elysium CRM - Outreach.csv"). Each row is deduplicated
    against existing contacts by email, LinkedIn URL, or name + company before it's added to the pipeline.
  </p>

  <%= form_with url: imports_path, method: :post, multipart: true, class: "space-y-4" do %>
    <div class="rounded-lg border-2 border-dashed border-slate-300 bg-white p-8 text-center">
      <%= file_field_tag "files", multiple: true, name: "files[]", accept: ".csv",
            class: "block w-full text-sm text-slate-600" %>
      <p class="mt-2 text-xs text-slate-400">You can select multiple .csv files at once.</p>
    </div>

    <%= submit_tag "Import contacts", class: "w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 cursor-pointer" %>
  <% end %>
</div>
