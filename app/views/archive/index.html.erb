<% content_for :title, "Archive" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Archive</h1>
    <p class="text-sm text-slate-500 mt-1">Low priority (red) contacts, kept out of the active pipeline.</p>
  </div>
  <span class="text-sm text-slate-500"><%= pluralize(@pagy.count, "contact") %></span>
</div>

<% if @contacts.any? %>
  <div class="space-y-3">
    <%= render partial: "contacts/row", collection: @contacts, as: :contact %>
  </div>

  <%= render "shared/pagination", pagy: @pagy, page_url: ->(n) { archive_path(request.query_parameters.merge(page: n)) } %>
<% else %>
  <div class="rounded-lg border border-dashed border-slate-300 p-10 text-center text-slate-500">
    No archived contacts.
  </div>
<% end %>
